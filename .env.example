# ============================================================
# IDOL Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# All SecretStr fields are masked in logs automatically.
# ============================================================

# --- App ---
APP_NAME=IDOL
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
TIMEZONE=Asia/Jakarta

# --- Telegram: HQ Bot ---
# Get from @BotFather
HQ_BOT_TOKEN=your-bot-token-here
HQ_BOT_USERNAME=IDOLHQBot

# --- Founder & Staff ---
# CRITICAL: This is the ONLY way to set the Founder.
# Must be a valid Telegram user ID (integer).
# The Founder cannot be changed via bot operations.
FOUNDER_TELEGRAM_ID=7714463332

# Optional: pre-configured Owner Telegram IDs (comma-separated)
# These users will be assigned the Owner role on bootstrap.
# Owners can also be assigned later by the Founder via bot.
OWNER_TELEGRAM_IDS=

# --- IDOL Team Group ---
# The Telegram group/supergroup used as the operational hub.
IDOL_TEAM_GROUP_ID=
TOPIC_SYSTEM_ID=
TOPIC_ORDERS_ID=
TOPIC_CUSTOMERS_ID=
TOPIC_STAFF_ID=

# --- Database ---
# PostgreSQL connection string (async)
DATABASE_URL=postgresql+asyncpg://idol:idol_secret@localhost:5432/idol_db

# --- AI (disabled for V1) ---
ENABLE_AI=false
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b
