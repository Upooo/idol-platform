# ============================================================
# IDOL Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# All SecretStr fields are masked in logs automatically.
# ============================================================

# --- App ---
APP_NAME=IDOL
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
TIMEZONE=Asia/Jakarta

# --- Telegram: HQ Bot ---
# Get from @BotFather
HQ_BOT_TOKEN=
HQ_BOT_USERNAME=

# --- Founder & Staff ---
# CRITICAL: This is the ONLY way to set the Founder.
# Must be a valid Telegram user ID (integer).
# The Founder cannot be changed via bot operations.
FOUNDER_TELEGRAM_ID=

# Optional: pre-configured Owner Telegram IDs (comma-separated)
OWNER_TELEGRAM_IDS=

# Optional: pre-configured Admin Telegram IDs (comma-separated)
ADMIN_TELEGRAM_IDS=

# --- IDOL Team Group ---
# The private Telegram group used as the operational hub.
# Must be a supergroup with forum/topics enabled.
IDOL_TEAM_GROUP_ID=
TOPIC_SYSTEM_ID=
TOPIC_ORDERS_ID=
TOPIC_STAFF_ID=

# --- Database ---
# PostgreSQL connection string (async)
DATABASE_URL=postgresql+asyncpg://idol:idol_secret@localhost:5432/idol_db

# --- AI (disabled for V1) ---
ENABLE_AI=false
GROQ_API_KEY=
AI_MODEL=
